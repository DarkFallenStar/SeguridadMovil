# Configuracion del Servidor
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Claves Secretas de Firma de Tokens (JWT / HMAC)
JWT_SECRET=super_secret_unisabana_key_change_in_production_123456
TOKEN_ISSUER=unisabana-auth

# Tiempos de Expiracion de Tokens (Especificacion del Taller)
ACCESS_TOKEN_TTL_SECONDS=300       # 5 minutos
REFRESH_TOKEN_TTL_DAYS=30          # 30 dias
STEP_UP_TOKEN_TTL_SECONDS=180      # 3 minutos
ELEVATED_TOKEN_TTL_SECONDS=600     # 10 minutos
ANTI_REPLAY_TTL_SECONDS=90         # 90 segundos

# Base de datos SQLite
DATABASE_PATH=./data/auth.sqlite

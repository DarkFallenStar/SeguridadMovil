{
  "name": "backend-auth",
  "version": "1.0.0",
  "description": "Backend de autenticacion ligera para el Taller de Seguridad Movil (UniSabana)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test:totp": "tsx src/tests/totp.test.ts",
    "test:stepup": "tsx src/tests/stepUpAntiReplay.test.ts",
    "test:pkce": "tsx src/tests/pkce.test.ts",
    "test:refresh": "tsx src/tests/silentRefresh.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}

